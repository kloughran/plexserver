# Append to /etc/ufw/after.rules, then: sudo ufw reload
# Blocks the plex network (172.30.0.0/24) from opening connections to any private
# address: the LAN, the router, and every other container. Replies to LAN clients
# and outbound internet traffic still pass.
*filter
:DOCKER-USER - [0:0]
-A DOCKER-USER -s 172.30.0.0/24 -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN
-A DOCKER-USER -s 172.30.0.0/24 -d 172.30.0.0/24 -j RETURN
-A DOCKER-USER -s 172.30.0.0/24 -d 10.0.0.0/8 -j DROP
-A DOCKER-USER -s 172.30.0.0/24 -d 172.16.0.0/12 -j DROP
-A DOCKER-USER -s 172.30.0.0/24 -d 192.168.0.0/16 -j DROP
-A DOCKER-USER -s 172.30.0.0/24 -d 169.254.0.0/16 -j DROP
-A DOCKER-USER -j RETURN
COMMIT
